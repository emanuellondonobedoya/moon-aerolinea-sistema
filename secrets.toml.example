# Copie este archivo como .streamlit/secrets.toml (NUNCA lo suba a GitHub) o use variables de entorno.

# Lectura automática con Claude Vision (opcional: sin clave el sistema funciona en modo manual asistido)
ANTHROPIC_API_KEY = "sk-ant-..."
# Modelo (opcional). Si no está disponible se prueban automáticamente claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5
# ANTHROPIC_MODEL = "claude-sonnet-5-5"

# Usuario semilla de Gerencia: solo se crea si la tabla de usuarios está vacía.
# En el primer ingreso el sistema OBLIGA a cambiar esta clave.
GERENCIA_CEDULA = "1000000000"
GERENCIA_PASSWORD = "Moon2026*"

# Carpeta persistente de datos (base SQLite, evidencias y respaldos). Use un disco que NO se borre al reiniciar.
# MOON_DATA_DIR = "/srv/moon_data"

# Ruta opcional a la plantilla NOVIEMBRE.xlsx para importar la hoja BD al primer arranque
# MOON_PLANTILLA_XLSX = "/srv/moon_data/NOVIEMBRE.xlsx"
